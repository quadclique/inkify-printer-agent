[Unit]
Description=Inkify Printer Agent Service
# Hard dependency: don't start until network is up
After=network.target network-online.target cups.service
# Soft dependency: try to start CUPS if not running, but don't fail if absent
Wants=network-online.target cups.service

[Service]
Type=simple
# Dedicated service account (created by postinst)
User={{USER}}
Group={{GROUP}}
WorkingDirectory=/opt/inkify

# Execute the standalone binary directly
ExecStart=/opt/inkify/inkify-agent

# Resilience: restart on crash after 10 seconds
Restart=always
RestartSec=10

# Hard stop timeout
KillMode=mixed
TimeoutStopSec=15

# Route stdout/stderr to journald (use: journalctl -u inkify-agent -f)
StandardOutput=journal
StandardError=journal
SyslogIdentifier=inkify-agent

# Security hardening
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target